FROM python:3.10-slim 

WORKDIR /app 
#thiết lập app làm thư mục mực định  để chạy các lệnh tiếp theo
# nếu app ch tồn tại, tự tạo mới 

COPY requirements.txt .
# copy requiement từ host vào thư mục app, dấu . đại diện cho app

#RUN pip install --no-cache-dir -r requirements.txt
#run: chạy lệnh này trong khi build image
#--no...: cấm pip lưu lại cache, giảm bộ nhớ cho image 

RUN pip install --no-cache-dir pip --upgrade && \
    pip install --default-timeout=1000 --no-cache-dir torch --extra-index-url https://download.pytorch.org/whl/cpu && \
    pip install --default-timeout=1000 --no-cache-dir -r requirements.txt


EXPOSE 8000

CMD ["uvicorn", "app.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
#các lệnh mặc định dc thực thi khi chính thức chạy container 



